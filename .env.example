# Postgres. Inside Compose this is overridden to host "postgres".
DATABASE_URL=postgresql://fathom:fathom@127.0.0.1:5432/fathom

# RPC endpoints. Public defaults work for the demo; set your own to avoid rate limits.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com

# Optional. Without it, verified ABIs come from Sourcify only.
ETHERSCAN_API_KEY=

# Optional. Alerts still post to the webhook when this is empty.
TELEGRAM_BOT_TOKEN=

# Keep these small. A few dozen blocks is enough for a live table and cheap on public RPCs.
INDEX_BLOCK_RANGE=80
INDEX_MAX_LOGS=100
INDEX_CHUNK_SIZE=15

# Path to the heimdall-rs binary. Compose sets /usr/local/bin/heimdall.
HEIMDALL_BIN=bin/heimdall
HEIMDALL_TIMEOUT_MS=90000

PORT=43123
